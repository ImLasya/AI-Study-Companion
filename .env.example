# ==============================================================================
# AI Study Companion - Environment Configuration Template
# Copy this file to .env before starting the application services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. CORS & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_study_companion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async connection URL format for SQLAlchemy asyncpg (used by FastAPI backend)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion

# Synchronous connection URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study_companion

# Test database URL for pytest test suite
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion_test

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY WORKER
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# In production, rotate to a cryptographically secure random 32+ char key (e.g. openssl rand -hex 32)
JWT_SECRET=development-insecure-secret-key-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 6. STORAGE & LOCAL VECTOR PIPELINE
# ------------------------------------------------------------------------------
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_BYTES=20971520
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 7. GOOGLE GEMINI LLM PROVIDER (Google AI Studio)
# ------------------------------------------------------------------------------
# Google AI Studio API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
TUTOR_SIMILARITY_THRESHOLD=0.65
TUTOR_TOP_K=5
TUTOR_MAX_QUESTION_LENGTH=2000
TUTOR_HISTORY_LIMIT=6

# ------------------------------------------------------------------------------
# 8. ADAPTIVE QUIZ & ASSESSMENT ENGINE
# ------------------------------------------------------------------------------
QUIZ_QUESTION_COUNT=5
QUIZ_MAX_OPTIONS=4
QUIZ_OPEN_ENDED_PASSING_SCORE=0.7

# ------------------------------------------------------------------------------
# 9. FRONTEND CONFIGURATION (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development
