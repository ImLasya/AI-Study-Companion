# ==============================================================================
# AI Study Companion - Environment Configuration Template
# Copy this file to .env before starting the services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & RUNTIME SETTINGS (Required for Phase 0)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. CORS & NETWORKING (Required for Phase 0)
# Comma-separated list of allowed origins.
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL + pgvector) (Required for Phase 0)
# Async connection URL format for SQLAlchemy asyncpg
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_study_companion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion

# Synchronous connection URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study_companion

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY WORKER (Required for Phase 0)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# ==============================================================================
# FUTURE PHASES CONFIGURATION (Optional for Phase 0)
# ==============================================================================

# 6. AUTHENTICATION & SECURITY (Phase 1)
JWT_SECRET=change-me-to-a-super-secret-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 7. AI & LLM PROVIDER (OpenAI / Embeddings) (Phase 3+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 8. OBJECT STORAGE (Supabase Storage / S3) (Phase 4+)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=study-companion-materials

# 9. OBSERVABILITY & EVALUATION (LangSmith / Tracing) (Phase 5+)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-study-companion
