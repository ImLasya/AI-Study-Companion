# ==============================================================================
# AI Study Companion - Frontend Environment Configuration Template (React + Vite)
# Copy this file to .env or .env.local before building or running Vite.
# ==============================================================================

# [REQUIRED FOR PRODUCTION] Base URL of the backend REST API
# In development, points to the local backend proxy (e.g. http://localhost:8000/api/v1)
# In production, must be set to the deployed backend API URL (e.g. https://api.study-companion.example.com/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# [OPTIONAL] Frontend environment indicator (development, staging, production)
VITE_APP_ENV=development
