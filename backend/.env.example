# Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study_companion

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Phase 3: AI Tutor & Google Gemini LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
TUTOR_SIMILARITY_THRESHOLD=0.65
TUTOR_TOP_K=5
TUTOR_MAX_QUESTION_LENGTH=2000

# Future Phases
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=study-companion-materials
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-study-companion
