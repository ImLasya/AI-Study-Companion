# ==============================================================================
# AI Study Companion - Backend Environment Configuration Template
# Copy this file to .env or backend/.env before running the backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime Settings
# ------------------------------------------------------------------------------
# [OPTIONAL] Runtime environment: development, staging, or production
ENVIRONMENT=development

# [OPTIONAL] Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# [OPTIONAL] Semantic version of the application
APP_VERSION=0.1.0

# [OPTIONAL] API prefix for all v1 routes
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 2. CORS & Networking
# ------------------------------------------------------------------------------
# [REQUIRED FOR PRODUCTION] Comma-separated list of allowed frontend origins (no trailing slashes)
# In production, set to your deployed frontend domain (e.g. https://study-companion.example.com)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# [REQUIRED] Primary asynchronous database connection string using asyncpg driver
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion

# [OPTIONAL] Synchronous connection URL used by Alembic migrations CLI if run synchronously
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study_companion

# [OPTIONAL] Test database URL used by pytest test runner
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion_test

# ------------------------------------------------------------------------------
# 4. Redis & Celery Background Workers
# ------------------------------------------------------------------------------
# [REQUIRED] Redis connection string for caching and general broker
REDIS_URL=redis://localhost:6379/0

# [REQUIRED] Celery task broker URL
CELERY_BROKER_URL=redis://localhost:6379/0

# [REQUIRED] Celery result backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 5. Authentication & Security
# ------------------------------------------------------------------------------
# [REQUIRED FOR PRODUCTION] Secret key used for signing JWT cookies and tokens.
# CRITICAL: Rotate to a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=development-insecure-secret-key-32-chars-long

# [OPTIONAL] JWT cryptographic signing algorithm
JWT_ALGORITHM=HS256

# [OPTIONAL] Access token lifespan in minutes (default 60 min)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# [OPTIONAL] Refresh token lifespan in minutes (default 7 days = 10080 min)
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 6. File Storage & Local Ingestion Pipeline
# ------------------------------------------------------------------------------
# [OPTIONAL] Base filesystem path where uploaded PDF documents are stored
# In production, ensure this path is mounted on a persistent disk or cloud volume
STORAGE_PATH=./storage

# [OPTIONAL] Maximum allowed upload file size in bytes (default 20MB)
MAX_UPLOAD_SIZE_BYTES=20971520

# [OPTIONAL] Local embedding model used for 384-dimensional dense vectorization
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 7. Google Gemini LLM Provider (AI Studio)
# ------------------------------------------------------------------------------
# [REQUIRED FOR AI FEATURES] Google AI Studio API key (https://aistudio.google.com/)
# Note: This codebase integrates with Google AI Studio (API key), NOT Vertex AI (no GCP service account needed)
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Gemini model identifier
GEMINI_MODEL=gemini-3.6-flash

# [OPTIONAL] Cosine distance threshold for grounded retrieval (distance <= threshold accepted)
TUTOR_SIMILARITY_THRESHOLD=0.65

# [OPTIONAL] Maximum number of chunks retrieved per question
TUTOR_TOP_K=5

# [OPTIONAL] Maximum question character length accepted by the Tutor
TUTOR_MAX_QUESTION_LENGTH=2000

# [OPTIONAL] Maximum number of prior conversation messages passed as context to the Tutor
TUTOR_HISTORY_LIMIT=6

# ------------------------------------------------------------------------------
# 8. Adaptive Quiz & Assessment Engine
# ------------------------------------------------------------------------------
# [OPTIONAL] Target number of questions generated per quiz
QUIZ_QUESTION_COUNT=5

# [OPTIONAL] Maximum MCQ answer choices generated
QUIZ_MAX_OPTIONS=4

# [OPTIONAL] Passing threshold for open-ended answers (0.0 to 1.0)
QUIZ_OPEN_ENDED_PASSING_SCORE=0.7
