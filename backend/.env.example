# Backend Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_study_companion
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_study_companion

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Future Phases (Optional for Phase 0)
JWT_SECRET=development-insecure-secret-key-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=study-companion-materials
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-study-companion
